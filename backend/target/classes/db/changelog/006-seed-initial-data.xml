    <!-- Seed данные: Начальные транзакции для пользователей (для аудита) -->
    <changeSet id="006-seed-initial-transactions" author="architect">
        <sql dbms="postgresql">
            INSERT INTO transactions (user_id, type, amount, balance_before, balance_after, bonus_balance_before, bonus_balance_after, reference_type, reference_id, status, description, created_at)
            SELECT 
                id, 
                'BONUS_GRANT'::transaction_type, 
                bonus_balance, 
                0, 
                bonus_balance, 
                0, 
                bonus_balance, 
                'SYSTEM', 
                NULL, 
                'COMPLETED', 
                'Initial bonus grant on system setup', 
                CURRENT_TIMESTAMP
            FROM users WHERE role != 'BOT';
        </sql>
    </changeSet>

